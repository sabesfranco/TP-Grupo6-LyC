package lyc.compiler;

%{
import java_cup.runtime.*;
import lyc.compiler.model.SymbolTable;
import lyc.compiler.model.SymbolEntry;
import lyc.compiler.model.SymbolType;
import lyc.compiler.utils.IntermediateCode;
import lyc.compiler.utils.SemanticChecker;
import java.util.List;
import java.util.ArrayList;
%}

class Parser;

terminal ASSIG;
terminal PLUS;
terminal SUB;
terminal MULT;
terminal DIV;
terminal MOD;
terminal DIV_INT;
terminal OPEN_BRACKET;
terminal CLOSE_BRACKET;
terminal OPEN_BRACE;
terminal CLOSE_BRACE;
terminal OPEN_SQUARE_BRACKET;
terminal CLOSE_SQUARE_BRACKET;
terminal COLON;
terminal COMMA;
terminal EQ;
terminal LT;
terminal GT;
terminal LE;
terminal GE;
terminal NE;
terminal INTEGER_CONSTANT;
terminal FLOAT_CONSTANT;
terminal STRING_CONSTANT;
terminal IDENTIFIER;
terminal INIT;
terminal FLOAT_TYPE;
terminal INT_TYPE;
terminal STRING_TYPE;
terminal IF;
terminal ELSE;
terminal WHILE;
terminal WHILE_SPECIAL;
terminal READ;
terminal WRITE;
terminal AND;
terminal OR;
terminal NOT;
terminal IN;
terminal DO;
terminal ENDWHILE;
terminal UMINUS;

non terminal program;
non terminal init_block;
non terminal decl_list;
non terminal decl;
non terminal List id_list;
non terminal SymbolType type;
non terminal sent_list;
non terminal sent;
non terminal assignment_sent;
non terminal if_sent;
non terminal if_body;
non terminal while_sent;
non terminal special_while_sent;
non terminal read_sent;
non terminal write_sent;
non terminal List expr_list;
non terminal String expression;
non terminal String term;
non terminal String factor_u;
non terminal String factor;
non terminal String condition;
non terminal String cond_and;
non terminal String cond_not;
non terminal String cond_atom;
non terminal String simple_condition;
non terminal String comp_op;

precedence left PLUS, SUB;
precedence left MULT, DIV, MOD, DIV_INT;
precedence right UMINUS;

start with program;

program ::= init_block sent_list {: System.out.println("Program completed"); :};
program ::= init_block {: System.out.println("Program with init only"); :};
program ::= sent_list {: System.out.println("Program completed"); :};
program ::= {: System.out.println("Empty program"); :};

init_block ::= INIT OPEN_BRACE decl_list CLOSE_BRACE {: System.out.println("Init block completed"); :};

decl_list ::= decl_list decl {: System.out.println("Multiple declarations"); :};
decl_list ::= decl {: System.out.println("First declaration"); :};

decl ::= id_list:ids COLON type:t {:
    String typeName = t == SymbolType.FLOAT ? "Float" : (t == SymbolType.INT ? "Int" : "String");
    List<String> varList = (List<String>) ids;
    for (String variableName : varList) {
        SemanticChecker.declare(variableName, typeName);
        SymbolEntry entry = new SymbolEntry(variableName, t);
        SymbolTable.getInstance().add(entry);
        System.out.println("Variable added to table: " + variableName + " (" + typeName + ")");
    }
    System.out.println("Type: " + typeName);
    System.out.println("Variable declaration with type: " + typeName);
:};

id_list ::= id_list:lista COMMA IDENTIFIER:id {:
    System.out.println("," + id);
    lista.add((String) id);
    RESULT = lista;
:}
| IDENTIFIER:id {:
    System.out.println("Variable: " + id);
    List<String> nueva = new ArrayList<>();
    nueva.add((String) id);
    RESULT = nueva;
:};

type ::= FLOAT_TYPE {: RESULT = SymbolType.FLOAT; :}
       | INT_TYPE {: RESULT = SymbolType.INT; :}
       | STRING_TYPE {: RESULT = SymbolType.STRING; :}
       ;

sent_list ::= sent_list sent;
sent_list ::= sent;

sent ::= assignment_sent
       | if_sent
       | while_sent
       | special_while_sent
       | read_sent
       | write_sent
       ;

assignment_sent ::= IDENTIFIER:id ASSIG expression:expr {:
    String name = (String) id;
    SemanticChecker.checkExists(name);
    SemanticChecker.checkAssignmentTypeCompatibility(name, SemanticChecker.inferPostfixType(expr));
    IntermediateCode.emitAssign(name, expr);
    System.out.println("Assignment: " + id + " = (expr)");
:};

if_sent ::= IF OPEN_BRACKET condition:cond CLOSE_BRACKET
            {: IntermediateCode.emitBranch(cond); :}
            if_body
          ;

if_body ::= OPEN_BRACE sent_list CLOSE_BRACE
            {: IntermediateCode.closeIfWithoutElse(); System.out.println("If"); :}
          ;
if_body ::= OPEN_BRACE sent_list CLOSE_BRACE
            {: IntermediateCode.closeIfThenForElse(); :}
            ELSE OPEN_BRACE sent_list CLOSE_BRACE
            {: IntermediateCode.closeIfElse(); System.out.println("If-else"); :}
          ;

while_sent ::= WHILE {: IntermediateCode.beginWhile(); System.out.println("While"); :}
               OPEN_BRACKET condition:cond CLOSE_BRACKET
               {: IntermediateCode.emitBranch(cond); :}
               OPEN_BRACE sent_list CLOSE_BRACE
               {: IntermediateCode.endWhile(); :}
               ;

special_while_sent ::= WHILE_SPECIAL IDENTIFIER:id IN OPEN_SQUARE_BRACKET expr_list:vals CLOSE_SQUARE_BRACKET
                       {:
    String name = (String) id;
    SemanticChecker.checkExists(name);
    IntermediateCode.addLine("" +0 + " @i :=");
    String firstExpression = (String) vals.get(0);
    IntermediateCode.addLine("" + firstExpression + " " + id + ":="); 
    IntermediateCode.beginWhileSpecial(); // ET
    System.out.println("WHILE IN loop for: " + name);
    :} DO sent_list ENDWHILE {: 
    int lastLine = IntermediateCode.addLine("" + "@i 1 + @i :=");
    
    List<String> values = (List<String>) vals;
    for (int index = 1; index < values.size(); index++) {
        //if(@i==1)

        IntermediateCode.addLine("@i " + index + " CMP BNE " + (lastLine + 5)); 
        String nextExpression = values.get(index);
        IntermediateCode.addLine("" + nextExpression + " " + id + ":="); 
        lastLine = IntermediateCode.addLine("BI " + IntermediateCode.peekWhileSpecial()); 
    }
    IntermediateCode.endWhileSpecial();
:};

expr_list ::= expr_list:list COMMA expression:expr {:
    list.add(expr);
    RESULT = list;
:};
expr_list ::= expression:expr {:
    List<String> list = new ArrayList<>();
    list.add(expr);
    RESULT = list;
:};

read_sent ::= READ OPEN_BRACKET IDENTIFIER:id CLOSE_BRACKET {:
    String name = (String) id;
    SemanticChecker.checkExists(name);
    IntermediateCode.emitRead(name);
    System.out.println("Read: " + id);
:};

write_sent ::= WRITE OPEN_BRACKET expression:expr CLOSE_BRACKET {:
    IntermediateCode.emitWrite(expr);
    System.out.println("Write");
:};

condition ::= condition:left OR cond_and:right {:
    System.out.println("Operator: OR");
    RESULT = left + " " + right + " OR";
:}
| cond_and:expr {: RESULT = expr; :}
;

cond_and ::= cond_and:left AND cond_not:right {:
    System.out.println("Operator: AND");
    RESULT = left + " " + right + " AND";
:}
| cond_not:expr {: RESULT = expr; :}
;

cond_not ::= NOT cond_not:operand {:
    System.out.println("Operator: NOT");
    RESULT = operand + " NOT";
:} %prec UMINUS
| cond_atom:expr {: RESULT = expr; :}
;

cond_atom ::= simple_condition:cond {: RESULT = cond; :}
            | OPEN_BRACKET condition:cond CLOSE_BRACKET {: RESULT = cond; :}
            ;

simple_condition ::= expression:left comp_op:op expression:right {:
    String leftExpressionType = SemanticChecker.inferPostfixType(left);
    String rightExpressionType = SemanticChecker.inferPostfixType(right);
    SemanticChecker.checkConditionTypeCompatibility(leftExpressionType, rightExpressionType);
    RESULT = left + " " + right + " " + op;
:};

comp_op ::= EQ {: System.out.println("Operator: =="); RESULT = "=="; :}
          | LT {: System.out.println("Operator: <"); RESULT = "<"; :}
          | GT {: System.out.println("Operator: >"); RESULT = ">"; :}
          | LE {: System.out.println("Operator: <="); RESULT = "<="; :}
          | GE {: System.out.println("Operator: >="); RESULT = ">="; :}
          | NE {: System.out.println("Operator: !="); RESULT = "!="; :}
          ;

expression ::= expression:expr1 PLUS term:term1 {:
    System.out.println("Operator: +");
    RESULT = expr1 + " " + term1 + " +";
:}
| expression:expr1 SUB term:term1 {:
    System.out.println("Operator: -");
    RESULT = expr1 + " " + term1 + " -";
:}
| term:term1 {: RESULT = term1; :}
;

term ::= term:term1 MULT factor_u:factor1 {:
    System.out.println("Operator: *");
    RESULT = term1 + " " + factor1 + " *";
:}
| term:term1 DIV factor_u:factor1 {:
    System.out.println("Operator: /");
    SemanticChecker.checkDivisionByZero(factor1);
    RESULT = term1 + " " + factor1 + " /";
:}
| term:term1 MOD factor_u:factor1 {:
    System.out.println("Operator: MOD");
    SemanticChecker.checkDivisionByZero(factor1);
    RESULT = term1 + " " + factor1 + " MOD";
:}
| term:term1 DIV_INT factor_u:factor1 {:
    System.out.println("Operator: DIV");
    SemanticChecker.checkDivisionByZero(factor1);
    RESULT = term1 + " " + factor1 + " DIV";
:}
| factor_u:factor1 {: RESULT = factor1; :}
;

factor_u ::= SUB factor:factor1 {:
    System.out.println("factor_u -> - factor");
    RESULT = "0 " + factor1 + " -";
:} %prec UMINUS
| PLUS factor:factor1 {:
    System.out.println("factor_u -> + factor");
    RESULT = factor1;
:} %prec UMINUS
| factor:factor1 {:
    System.out.println("factor_u -> factor");
    RESULT = factor1;
:}
;

factor ::= IDENTIFIER:id {:
    String name = (String) id;
    SemanticChecker.checkExists(name);
    System.out.println("Id: " + id);
    RESULT = name;
:}
| INTEGER_CONSTANT:c {:
    String val = (String) c;
    System.out.println("Integer: " + val);
    if (!SymbolTable.getInstance().contains(val)) {
        SymbolEntry e = new SymbolEntry(val, SymbolType.INT);
        e.setValue(val);
        SymbolTable.getInstance().add(e);
    }
    RESULT = val;
:}
| FLOAT_CONSTANT:c {:
    String val = (String) c;
    System.out.println("Float: " + val);
    if (!SymbolTable.getInstance().contains(val)) {
        SymbolEntry e = new SymbolEntry(val, SymbolType.FLOAT);
        e.setValue(val);
        SymbolTable.getInstance().add(e);
    }
    RESULT = val;
:}
| STRING_CONSTANT:c {:
    String val = (String) c;
    System.out.println("String: " + val);
    if (!SymbolTable.getInstance().contains(val)) {
        SymbolEntry e = new SymbolEntry(val, SymbolType.STRING);
        e.setValue(val);
        SymbolTable.getInstance().add(e);
    }
    RESULT = val;
:}
| OPEN_BRACKET expression:expr CLOSE_BRACKET {: RESULT = expr; :}
;
